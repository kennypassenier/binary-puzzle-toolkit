#!/usr/bin/env bash
# Git-native traceability gate (standing rule 4): the message must carry
# the feature/milestone IDs it implements, or [meta] for infrastructure.
set -euo pipefail

msg_file="$1"

if ! grep -qE '\[(meta|[A-Za-z]{1,4}[0-9])[^]]*\]' "$msg_file"; then
  {
    echo "COMMIT BLOCKED — message lacks feature/milestone IDs (standing rule 4)."
    echo "Add the IDs this commit implements, e.g.: feat(L4b): carve loop [K2, K5]"
    echo "Pure infrastructure commits use [meta]."
  } >&2
  exit 1
fi
