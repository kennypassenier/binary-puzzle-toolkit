#!/usr/bin/env bash
# Git-native gate (Phase 5): runs the project's quality gates before
# every commit, from ANY session, tool or terminal. The Claude Code
# PreToolUse hook is a second layer, not the only one.
set -uo pipefail

root=$(git rev-parse --show-toplevel)
gates="$root/.claude/hooks/gates.sh"

if [ ! -x "$gates" ]; then
  echo "COMMIT BLOCKED — $gates is missing or not executable." >&2
  exit 1
fi

# One full test run per release (Kenny, 2026-09-29): workstation's
# gate-stamp skips the suite for a commit that only moves the version, and
# stamps a green tree so the release does not test it again. Without
# workstation the gates simply run.
gate_stamp="$HOME/Projects/workstation/bin/gate-stamp"
run_gates() {
  if [ -x "$gate_stamp" ]; then "$gate_stamp" hook "$gates" 'Cargo.toml:^version = ' 'Cargo.lock:^version = ' 'CHANGELOG.md:.*'; else "$gates"; fi
}

if ! out=$(cd "$root" && run_gates 2>&1); then
  {
    echo "COMMIT BLOCKED — gates failed (standing rule 7). Fix, then retry."
    echo "$out" | tail -30
  } >&2
  exit 1
fi
