#!/usr/bin/env bash
# Git-native gate (Phase 5, amended 2026-08-12): holds from ANY session,
# tool or terminal — the Claude Code PreToolUse hook is a second layer,
# not the only one. Runs the project's quality gates; non-zero blocks.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
gates="$repo_root/.claude/hooks/gates.sh"

[ -x "$gates" ] || exit 0

if ! out=$(cd "$repo_root" && "$gates" 2>&1); then
  {
    echo "COMMIT BLOCKED — gates failed (standing rule 7). Fix, then retry."
    echo "$out" | tail -30
  } >&2
  exit 1
fi
